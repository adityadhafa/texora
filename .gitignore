# Node / pnpm
node_modules/
dist/
.pnpm-store/
*.tsbuildinfo

# Vite / build output
apps/desktop/dist/

# Rust / Tauri
target/
apps/desktop/src-tauri/target/
# Tauri-generated ACL/schema files (regenerated by tauri-build)
apps/desktop/src-tauri/gen/

# Frozen engine sidecars (produced by scripts/build-engine, never committed)
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# PyInstaller build/dist artifacts
build/
*.spec.bak
engine/build/
engine/dist/
engine/.build/

# Logs
*.log
logs/

# Git worktrees (M4+ feature branches live here)
.worktrees/

# OS / editor cruft
.DS_Store
Thumbs.db
