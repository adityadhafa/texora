{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Texora desktop shell (Tauri v2 + React + TypeScript).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && pnpm run typecheck:node && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "2.5.0",
    "i18next": "26.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.20"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@tauri-apps/api": "2.9.0",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "@types/node": "22.12.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "7.0.0",
    "vitest": "3.2.7"
  }
}
